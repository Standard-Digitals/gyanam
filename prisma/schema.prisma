// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  phone      String   @unique
  name       String?
  email      String?
  targetExam String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OtpSession {
  id        String   @id @default(cuid())
  phone     String
  otpHash   String
  purpose   String   @default("login")
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

enum LeadSource {
  HERO_QUERY
  CONTACT_FORM
  MENTORSHIP
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Lead {
  id         String     @id @default(cuid())
  fullName   String
  phone      String
  email      String?
  targetExam String?
  mode       String?
  center     String?
  message    String?
  source     LeadSource
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([phone])
}

model Course {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  category          String
  targetExam        String
  badge             String?
  rating            Float
  reviewsCount      Int
  studentsEnrolled  Int
  instructor        Json
  duration          String
  lessonsCount      Int
  language          String
  originalPrice     Int
  discountPrice     Int
  features          String[]
  thumbnail         String
  popular           Boolean  @default(false)
  syllabusOverview  Json
  startDate         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
}

model Mentor {
  id                  String   @id @default(cuid())
  name                String
  title               String
  experienceYears     Int
  qualification       String
  exRole              String?
  subject             String
  selectionsMentored  Int
  rating              Float
  image               String
  bio                 String
  createdAt           DateTime @default(now())
}

model SuccessStory {
  id                String   @id @default(cuid())
  studentName       String
  examCleared       String
  rank              String
  year              Int
  photoUrl          String
  videoUrl          String?
  youtubeUrl        String?
  youtubeViews      String?
  videoDuration     String?
  hasVideo          Boolean  @default(false)
  testimonial       String
  previousAttempts  String
  hometown          String
  badge             String
  category          String
  rollNumber        String?
  score             String?
  createdAt         DateTime @default(now())
}

model CurrentAffairItem {
  id                String   @id @default(cuid())
  slug              String?  @unique
  title             String
  category          String
  date              String
  readTime          String
  summary           String
  bullets           String[]
  impForExams       String[]
  thumbnail         String?
  fullContent       String[]
  keyTakeaways      String[]
  backgroundContext String?
  mcqQuestion       Json?
  syllabusTag       String?
  sourceName        String?
  author            String?
  createdAt         DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model DailyQuizQuestion {
  id             Int      @id @default(autoincrement())
  question       String
  options        String[]
  correctAnswer  Int
  explanation    String
  examTag        String
  createdAt      DateTime @default(now())
}

model FreeResource {
  id               String   @id @default(cuid())
  title            String
  type             String
  category         String
  fileSize         String
  downloadsCount   Int      @default(0)
  rating           Float
  description      String
  language         String?
  pagesCount       Int?
  chapters         String[]
  updatedDate      String?
  targetExams      String[]
  isHot            Boolean  @default(false)
  originalPrice    Int?
  price            Int?
  reviewsCount     Int?
  author           String?
  badge            String?
  coverBg          String?
  coverImage       String?
  images           String[]
  publisher        String?
  isbn             String?
  edition          String?
  weight           String?
  inStock          Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([category])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  category  String
  date      String
  readTime  String
  author    String
  excerpt   String
  imageUrl  String
  createdAt DateTime @default(now())
}

model FAQItem {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  createdAt DateTime @default(now())
}

model Quiz {
  id               String   @id @default(cuid())
  title            String
  subject          String
  examCategory     String
  date             String
  totalQuestions   Int
  timeLimitMinutes Int
  totalMarks       Int
  difficulty       String
  questions        Json
  createdAt        DateTime @default(now())
}

model QuizAttempt {
  id               String   @id @default(cuid())
  userId           String
  quizId           String
  correctCount     Int
  incorrectCount   Int
  unattemptedCount Int
  obtainedMarks    Float
  accuracy         Int
  timeTakenSec     Int
  submittedAt      DateTime @default(now())

  @@index([userId])
  @@index([quizId])
  @@index([submittedAt])
}

model DownloadLog {
  id           String   @id @default(cuid())
  userId       String?
  resourceId   String
  ipAddress    String?
  downloadedAt DateTime @default(now())

  @@index([resourceId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("editor")
  createdAt    DateTime @default(now())
}

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  userId         String
  items          Json
  subtotal       Int
  promoCode      String?
  promoDiscount  Int      @default(0)
  shippingFee    Int      @default(0)
  grandTotal     Int
  deliverySpeed  String
  paymentMethod  String
  paymentStatus  String   @default("PENDING")
  orderStatus    String   @default("PLACED")
  fullName       String
  mobile         String
  email          String
  addressLine    String
  pincode        String
  city           String
  state          String
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SupportTicket {
  id              String   @id @default(cuid())
  ticketNumber    String   @unique
  studentName     String
  phone           String
  email           String?
  rollNoOrOrderId String?
  category        String
  urgency         String
  description     String
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}

model Chapter {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([courseId])
}

model Topic {
  id        String   @id @default(cuid())
  chapterId String
  title     String
  order     Int      @default(0)
  videoType String
  videoUrl  String?
  duration  String?
  createdAt DateTime @default(now())

  @@index([chapterId])
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  paymentType String   @default("FREE")
  status      String   @default("ACTIVE")
  enrolledAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
